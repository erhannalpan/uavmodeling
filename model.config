<?xml version="1.0"?>
<!--
  model.config
  Original working model metadata supplied by Erhan; explanatory comments added.
  All original element names and values are retained.

  LOCATION
  Keep this file at models/quadrotor/model.config, beside model.sdf.
  The world includes model://quadrotor; the quadrotor resource directory and
  this metadata identify the SDF file containing the actual vehicle definition.
  GZ_SIM_RESOURCE_PATH should include the parent models directory.

  This metadata file does not define vehicle dynamics or motor commands.
  Masses, inertias, links, joints, motor systems, and odometry configuration
  belong in model.sdf. The initial vehicle pose is set by the world include.
-->
<model>
  <!-- Descriptive model name. It differs from the resource folder quadrotor
       and the instance name supplied by the world; preserve these distinctions
       when explaining resource lookup and identifying entities in Gazebo. -->
  <name>MATLAB Co-Simulation Quadrotor</name>

  <!-- Version of this model resource, not the installed Gazebo version. -->
  <version>1.0</version>

  <!-- Load model.sdf relative to this directory. The version attribute declares
       the SDF format of that file, not the model-resource version above. -->
  <sdf version="1.9">model.sdf</sdf>

  <!-- Original model author metadata. -->
  <author>
    <name>Erhan Alpan</name>
  </author>

  <!-- Human-readable purpose of the resource. -->
  <description>
    Quadrotor model for MATLAB and Gazebo co-simulation.
  </description>
</model>
